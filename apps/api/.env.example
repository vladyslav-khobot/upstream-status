# Port the API listens on.
PORT=3001
# Origin allowed to call the API from a browser. Not needed in dev: Vite proxies /api.
CORS_ORIGIN=http://localhost:5173
# How long a status page response is reused before it is fetched again.
CACHE_TTL_MS=10000
# Upper bound for a single request to an upstream status page.
UPSTREAM_TIMEOUT_MS=45000
# Token required by /api/admin/* (the web app sends VITE_ADMIN_TOKEN).
ADMIN_TOKEN=
